APP_ORIGIN=http://localhost:47831
ALLOW_INSECURE_COOKIES=true
AUTH_USERS_JSON=[{"email":"you@example.com","password_hash":"REPLACE_WITH_BCRYPT_HASH","name":"Your name"},{"email":"partner@example.com","password_hash":"REPLACE_WITH_BCRYPT_HASH","name":"Partner"}]
# Behind a reverse proxy: its address or CIDR as the container sees it (often the Docker bridge gateway).
TRUSTED_PROXY_CIDRS=
# BACKUP_DIR belongs in .env (read by Compose itself), not in .env.runtime.
BACKUP_DIR=/Users/REPLACE_WITH_YOUR_USERNAME/backups/simply-finance
