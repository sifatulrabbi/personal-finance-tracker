{
  "name": "finance-tracker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "bun --bun next dev --port 3004",
    "build": "bun --bun next build --webpack",
    "start": "bun --bun next start",
    "db:dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:dev:down": "docker compose -f docker-compose.dev.yml down",
    "db:dev:logs": "docker compose -f docker-compose.dev.yml logs -f postgres",
    "db:migrate": "bun run src/scripts/db-migrate.ts",
    "db:migrate:test": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://finance_tracker:finance_tracker@localhost:54329/finance_tracker_test} bun run src/scripts/db-migrate.ts --test",
    "db:seed": "bun run src/scripts/db-seed.ts",
    "db:seed:test": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://finance_tracker:finance_tracker@localhost:54329/finance_tracker_test} bun run src/scripts/db-seed.ts --test",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,md,yml}\"",
    "test": "bun test src/libs src/app/api 'src/app/(authenticated)' src/components",
    "test:api": "bun test src/app/api",
    "test:integration": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://finance_tracker:finance_tracker@localhost:54329/finance_tracker_test} bun test src/test/integration",
    "typecheck": "bun --bun next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@workos-inc/authkit-nextjs": "^3.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.7.0",
    "next": "16.2.2",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "shadcn": "4.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "ulid": "^3.0.2",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/bun": "1.3.11",
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.2",
    "prettier": "3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
