{
  "name": "finance-tracker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build --webpack",
    "start": "bun --bun next start",
    "db:dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:dev:down": "docker compose -f docker-compose.dev.yml down",
    "db:dev:logs": "docker compose -f docker-compose.dev.yml logs -f postgres",
    "db:migrate": "bun run src/scripts/db-migrate.ts",
    "db:migrate:test": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://finance_tracker:finance_tracker@localhost:54329/finance_tracker_test} bun run src/scripts/db-migrate.ts --test",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,md,yml}\"",
    "test": "bun test src/libs",
    "test:integration": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://finance_tracker:finance_tracker@localhost:54329/finance_tracker_test} bun test src/test/integration",
    "typecheck": "bun --bun next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.7.0",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "4.1.2",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "ulid": "^3.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bun": "1.3.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "prettier": "3.8.1",
    "tailwindcss": "^4",
    "typescript": "^6"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
