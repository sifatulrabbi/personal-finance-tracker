{
  "name": "simply-finance-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1 --port 47832 --strictPort",
